From 9bc7385f975e3af9d5916b4ad9bde7737d2f6f58 Mon Sep 17 00:00:00 2001
From: chitulinux <chitulinux@invalid>
Date: Sun, 15 Nov 2026 17:29:55 +0100
Subject: [PATCH] win32u: Move a maximized position set by the application to
 the window's monitor.

The ptMaxPosition an application sets in WM_GETMINMAXINFO is relative to
the primary monitor, and Windows moves it to the monitor of the window.
Qt sets it for frameless windows (relative to the monitor's origin), so
CHITUBOX on a second monitor maximized onto the primary one.
---
 dlls/win32u/window.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 8bb183503d9..d5e8b93c63a 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -4588,6 +4588,7 @@ MINMAXINFO get_min_max_info( HWND hwnd )
     RECT rc_max, rc_primary;
     DWORD adjusted_style;
     MINMAXINFO minmax;
+    POINT sent_pos;
     INT xinc, yinc;
     RECT rc;
     WND *win;
@@ -4634,12 +4635,15 @@ MINMAXINFO get_min_max_info( HWND hwnd )
         release_win_ptr( win );
     }
 
+    sent_pos = minmax.ptMaxPosition;
     send_message( hwnd, WM_GETMINMAXINFO, 0, (LPARAM)&minmax );
 
     /* if the app didn't change the values, adapt them for the current monitor */
 
     if (get_maximized_rect( hwnd, &rc_max ))
     {
+        MONITORINFO mon_info = monitor_info_from_window( hwnd, MONITOR_DEFAULTTOPRIMARY );
+
         rc_primary = get_primary_monitor_rect( get_thread_dpi() );
         if (minmax.ptMaxSize.x == (rc_primary.right - rc_primary.left) + 2 * xinc &&
             minmax.ptMaxSize.y == (rc_primary.bottom - rc_primary.top) + 2 * yinc)
@@ -4652,6 +4656,13 @@ MINMAXINFO get_min_max_info( HWND hwnd )
             minmax.ptMaxPosition.x = rc_max.left - xinc;
             minmax.ptMaxPosition.y = rc_max.top - yinc;
         }
+        else if (minmax.ptMaxPosition.x != sent_pos.x || minmax.ptMaxPosition.y != sent_pos.y)
+        {
+            /* a position set by the application is relative to the primary monitor, and Windows
+             * moves it to the window's monitor. Qt sets one for frameless windows */
+            minmax.ptMaxPosition.x += mon_info.rcMonitor.left - rc_primary.left;
+            minmax.ptMaxPosition.y += mon_info.rcMonitor.top - rc_primary.top;
+        }
     }
 
     TRACE( "%d %d / %d %d / %d %d / %d %d\n",
-- 
2.53.0

