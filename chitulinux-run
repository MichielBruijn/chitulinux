#!/bin/bash
# ChituLinux: CHITUBOX under the bundled Wine, in its own prefix
#
# usage: ChituLinux-x86_64.AppImage [command | FILE...]
#   (none) | FILE...   start CHITUBOX (installs it first when needed), opening FILEs
#   install [EXE]      install or update CHITUBOX with its Windows installer (default: the newest in ~/Downloads)
#   update             look for a newer ChituLinux (GitHub) and a newer CHITUBOX installer (~/Downloads)
#   update-check on|off  whether a start looks for a newer ChituLinux (once a day; on)
#   settings           scale, graphics, Wine's tools
#   scale PERCENT|auto size of text and icons (100 = normal; auto follows the desktop)
#   rpp URL|off        send to Resin Print Portal: a printer "RPP (...)" in CHITUBOX (e.g. http://host:5001)
#   winecfg | regedit | shell
#   stop               stop CHITUBOX and Wine
#   integrate          (re)make the app menu entry
#
# environment: CHITULINUX_HOME (default ~/.local/share/chitulinux), CHITUBOX_SCALE=PERCENT, CHITUBOX_GPU=auto|intel|nvidia,
#   CHITULINUX_UPDATE_CHECK=0, CHITULINUX_MIGRATE_FROM (default ~/.wine)

set -u
HERE="$(dirname "$(readlink -f "$0")")"
DATA="${CHITULINUX_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/chitulinux}"
TOOLS="$HERE/usr/lib/chitulinux"
VERSION="$(cat "$HERE/usr/share/chitulinux/VERSION" 2>/dev/null)"
SELF="${APPIMAGE:-$(readlink -f "$0")}"
LOG="$DATA/chitubox.log"
export WINEPREFIX="$DATA/prefix"
export WINE="$HERE/usr/bin/wine" WINESERVER="$HERE/usr/bin/wineserver"
export PATH="$HERE/usr/bin:$PATH"
export WINEDEBUG="${WINEDEBUG:-fixme-all}"
# no Wine menu entries: they would start CHITUBOX without this Wine
export WINEDLLOVERRIDES="winemenubuilder.exe=d${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"
# no drive letters for USB sticks and SD cards (they stay reachable through Z:)
export DBUS_SYSTEM_BUS_ADDRESS="unix:path=/dev/null/no-system-bus"
[ -z "${XCURSOR_SIZE:-}" ] && export XCURSOR_SIZE=$("$TOOLS/desktop-dpi" --cursor 2>/dev/null || echo 24)
APPDIR='C:\Program Files\CHITUBOX'
EXE="$WINEPREFIX/drive_c/Program Files/CHITUBOX/CHITUBOX.exe"
ICON="$DATA/chitubox.png"
DESKTOP="${XDG_DATA_HOME:-$HOME/.local/share}/applications/chitulinux-chitubox.desktop"
RELEASES=https://github.com/MichielBruijn/chitulinux/releases
CHITUBOX_DOWNLOAD=https://www.chitubox.com/en/download/chitubox-free
mkdir -p "$DATA"

msg() { echo "chitulinux: $*" >&2; }
gui() { [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v zenity >/dev/null; }

tell()  # info|error|question TEXT
{
    msg "$(printf '%b' "$2" | sed 's/<[^>]*>//g' | tr -s '\n' ' ')"
    if gui; then
        zenity --"$1" --width=460 --title=ChituLinux --text="$2" 2>/dev/null
    else
        [ "$1" != error ]
    fi
}

# --- prefix --------------------------------------------------------------------------------------------

make_prefix()
{
    [ -f "$WINEPREFIX/.chitulinux" ] && return
    msg "making the Wine prefix in $WINEPREFIX"
    # CHITUBOX uses neither .NET (Mono) nor Internet Explorer (Gecko): no download dialogs for them
    WINEDLLOVERRIDES="$WINEDLLOVERRIDES;mscoree,mshtml=" "$WINE" wineboot -i >> "$LOG" 2>&1 ||
        { tell error "Wine could not make its prefix, see $LOG."; exit 1; }
    # DXVK: Qt Quick draws with Direct3D 11, which Wine's own (on OpenGL) does slowly
    local d arch
    for arch in x64:system32 x32:syswow64; do
        for d in "$TOOLS/dxvk/${arch%%:*}"/*.dll; do
            cp -f "$d" "$WINEPREFIX/drive_c/windows/${arch#*:}/"
        done
    done
    for d in d3d9 d3d10core d3d11 dxgi; do
        "$WINE" reg add 'HKCU\Software\Wine\DllOverrides' /v "$d" /d native /f >/dev/null 2>&1
    done
    "$WINESERVER" -w
    touch "$WINEPREFIX/.chitulinux"
}

# Z: is the home folder, not /; and no letters Wine made for removable drives
fix_drives()
{
    local l
    [ "$(readlink "$WINEPREFIX/dosdevices/z:")" = "$HOME" ] || ln -sfn "$HOME" "$WINEPREFIX/dosdevices/z:"
    for l in "$WINEPREFIX"/dosdevices/?:; do
        case "$(readlink "$l")" in /media/*|/run/media/*) rm -f "$l" ;; esac
    done
    for l in "$WINEPREFIX"/dosdevices/?::; do [ -L "${l%:}" ] || rm -f "$l"; done
    # Windows' desktop stays in the prefix: installers put .lnk shortcuts there, useless on the Linux desktop.
    # A file in it, else wineboot turns the empty folder back into a link
    for l in "$WINEPREFIX"/drive_c/users/*/Desktop; do
        [ -L "$l" ] || continue
        rm -f "$l" && mkdir -p "$l" && touch "$l/desktop.ini"
    done
}

# --- versions ------------------------------------------------------------------------------------------

newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }  # A B: A is newer

# CHITUBOX_WIN64_Installer_v1.4.1.exe (or …v1.4.1 (1).exe from a second download): 1.4.1
installer_version()
{
    basename "$1" | sed -n 's/^.*[_ -][vV]\{0,1\}\([0-9][0-9.]*[0-9]\) \{0,1\}\(([0-9]*)\)\{0,1\}\.exe$/\1/p'
}

# the newest CHITUBOX installer in the usual places
find_installer()
{
    local f v best='' bv=''
    for f in "$HOME/Downloads"/CHITUBOX*Installer*.exe "$(xdg-user-dir DOWNLOAD 2>/dev/null)"/CHITUBOX*Installer*.exe \
            "$HOME"/CHITUBOX*Installer*.exe; do
        [ -f "$f" ] || continue
        v="$(installer_version "$f")"
        if [ -z "$best" ] || newer "${v:-0}" "${bv:-0}"; then best="$f" bv="$v"; fi
    done
    [ -n "$best" ] && echo "$best"
}

# the installed CHITUBOX's version (its files don't say it): written when installing; for an installation
# without it, that of the newest installer at hand, which it was installed with
chitubox_version()
{
    [ -s "$DATA/chitubox-version" ] || [ ! -f "$EXE" ] ||
        installer_version "$(find_installer)" > "$DATA/chitubox-version"
    cat "$DATA/chitubox-version" 2>/dev/null
}

# a CHITUBOX in this prefix
chitubox_running()
{
    local p
    for p in $(pgrep -u "$(id -u)" -f 'CHITUBOX\.exe'); do
        tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -qxF "WINEPREFIX=$WINEPREFIX" && return 0
    done
    return 1
}

# --- an existing CHITUBOX in another prefix ------------------------------------------------------------

# Its settings, printers and login (the login holds only on the same Windows machine ID, so that too).
# Asked once, when CHITUBOX is installed here for the first time
OLD_PREFIX="${CHITULINUX_MIGRATE_FROM:-$HOME/.wine}"
migrate_settings()
{
    local old="$OLD_PREFIX/drive_c/users/$USER/AppData" new="$WINEPREFIX/drive_c/users/$USER/AppData" d guid
    [ -d "$old/Local/Chitubox_2025" ] && [ ! -e "$new/Local/Chitubox_2025" ] || return 0
    tell question "<b>CHITUBOX is also installed in ${OLD_PREFIX/#$HOME/\~}.</b>\n\nTake over its settings, printers and login? That installation stays, only its app menu entry is hidden (it doesn't start with ChituLinux' Wine)." ||
        return 0
    msg "taking over CHITUBOX's settings from $OLD_PREFIX"
    mkdir -p "$new/Local/Chitubox_2025" "$new/Roaming"
    # not the caches, CHITUBOX makes them again
    for d in "$old/Local/Chitubox_2025"/*; do
        case "${d##*/}" in cache|qt_runtime_cache) ;; *) cp -a "$d" "$new/Local/Chitubox_2025/" ;; esac
    done
    [ -d "$old/Local/ChituManager" ] && cp -a "$old/Local/ChituManager" "$new/Local/"
    [ -d "$old/Roaming/Chitubox_2025" ] && cp -a "$old/Roaming/Chitubox_2025" "$new/Roaming/"
    guid="$(sed -n '/^\[Software\\\\Microsoft\\\\Cryptography\]/,/^$/s/^"MachineGuid"="\([^"]*\)".*/\1/p' \
        "$OLD_PREFIX/system.reg" 2>/dev/null)"
    [ -n "$guid" ] &&
        "$WINE" reg add 'HKLM\Software\Microsoft\Cryptography' /v MachineGuid /d "$guid" /f /reg:64 >/dev/null 2>&1
    # CHITUBOX would report the old installation's crashes again (Software Bug Feedback), without their dumps
    python3 -I - "$new/Local/Chitubox_2025/default_account"/*/kvcofnig.dat <<'EOF' >> "$LOG" 2>&1
import os, shutil, sqlite3, sys
for db in sys.argv[1:]:
    if not os.path.isfile(db):
        continue
    shutil.copy2(db, db + '.bak-chitulinux')
    try:
        with sqlite3.connect(db) as c:
            n = c.execute("DELETE FROM t_kvconfig WHERE CAST(F_VALUE AS TEXT) LIKE '%.dmp%'").rowcount
        print(f'{db}: {n} old crash reports removed')
    except sqlite3.Error as e:
        print(f'{db}: {e}')
EOF
    for d in "${XDG_DATA_HOME:-$HOME/.local/share}"/applications/wine/Programs/CHITUBOX*.desktop; do
        [ -f "$d" ] && mv -f "$d" "$d.bak-chitulinux"
    done
    return 0
}

install_chitubox()  # [INSTALLER]
{
    local exe="${1:-}"
    [ -n "$exe" ] || exe="$(find_installer)"
    if [ -z "$exe" ] && gui; then
        tell info "ChituLinux needs CHITUBOX's Windows installer (CHITUBOX_WIN64_Installer_….exe).\n\nDownload it from chitubox.com (Windows, 64-bit) and choose it in the next window." || exit 1
        xdg-open "$CHITUBOX_DOWNLOAD" >/dev/null 2>&1 &
        exe="$(zenity --file-selection --title='CHITUBOX installer' --filename="$HOME/Downloads/" \
            --file-filter='CHITUBOX installer | *.exe' 2>/dev/null)"
    fi
    [ -f "$exe" ] || { tell error "No CHITUBOX installer found."; exit 1; }
    if chitubox_running; then
        tell question "CHITUBOX is running. Save your work there first.\n\nClose CHITUBOX and install $(basename "$exe")?" ||
            exit 0
    fi
    make_prefix
    fix_drives
    [ -f "$EXE" ] || migrate_settings
    msg "installing $(basename "$exe")"
    stop_wine
    local root='C:\Program Files\CHITUBOX' rc prog="${EXE%/*}" old="$DATA/.previous"
    rm -f "$DATA/.install-rc"
    (
        # An update: CHITUBOX's installer would start the old one's uninstaller and wait for its wizard. So
        # remove it first, with its own uninstaller (that leaves the settings in AppData), and keep its files
        # (hard links) to put back when the new one fails
        if [ -f "$prog/Uninstall.exe" ]; then
            rm -rf "$old"
            cp -al "$prog" "$old" 2>>"$LOG" || rm -rf "$old"
            "$WINE" "$prog/Uninstall.exe" purge --confirm-command >> "$LOG" 2>&1
            "$WINESERVER" -w
            [ ! -f "$prog/Uninstall.exe" ] || { echo uninstall > "$DATA/.install-rc"; exit; }
        fi
        "$WINE" "$exe" install --root "$root" --accept-licenses --accept-messages --confirm-command >> "$LOG" 2>&1
        echo $? > "$DATA/.install-rc"
    ) | if gui; then zenity --progress --pulsate --auto-close --no-cancel --title=ChituLinux \
            --text="Installing $(basename "$exe")…" 2>/dev/null; else cat; fi
    rc="$(cat "$DATA/.install-rc" 2>/dev/null)"; rm -f "$DATA/.install-rc"
    "$WINESERVER" -w
    if [ "$rc" != 0 ] || [ ! -f "$EXE" ]; then
        msg "installing failed ($rc)"
        if [ -d "$old" ]; then
            rm -rf "$prog" && mv "$old" "$prog"
            tell error "Installing $(basename "$exe") failed, the CHITUBOX you had stays. See $LOG."
        else
            tell error "Installing CHITUBOX failed, see $LOG."
        fi
        exit 1
    fi
    rm -rf "$old"
    installer_version "$exe" > "$DATA/chitubox-version"
    rm -f "$DATA/.chitubox-skip"
    integrate
    msg "CHITUBOX installed"
}

# --- settings at start ---------------------------------------------------------------------------------

set_dpi() { "$WINE" reg add 'HKCU\Control Panel\Desktop' /v LogPixels /t REG_DWORD /d "$1" /f >/dev/null 2>&1; }

# a fixed scale (settings), else the desktop's
apply_scale()
{
    local s="${CHITUBOX_SCALE:-$(cat "$DATA/scale" 2>/dev/null)}"
    case "$s" in
        ''|auto) set_dpi "$("$TOOLS/desktop-dpi" 2>/dev/null || echo 96)" ;;
        *[!0-9]*) msg "scale $s is not a percentage" ;;
        *) set_dpi $(( s * 96 / 100 )) ;;
    esac
}

setup_gpu()
{
    local mode="${CHITUBOX_GPU:-$(cat "$DATA/gpu" 2>/dev/null)}"
    case "${mode:-auto}" in
        intel)  export DXVK_FILTER_DEVICE_NAME="${DXVK_FILTER_DEVICE_NAME:-Intel}" ;;
        nvidia) export DXVK_FILTER_DEVICE_NAME="${DXVK_FILTER_DEVICE_NAME:-NVIDIA}"
                export __NV_PRIME_RENDER_OFFLOAD=1 __VK_LAYER_NV_optimus=NVIDIA_only ;;
    esac
    msg "graphics ${mode:-auto}${DXVK_FILTER_DEVICE_NAME:+ ($DXVK_FILTER_DEVICE_NAME)}"
}

# --- running -------------------------------------------------------------------------------------------

stop_wine() { "$WINESERVER" -k 2>/dev/null; "$WINESERVER" -w 2>/dev/null; }

# the menu entry and the icon from CHITUBOX.exe; Exec follows this AppImage when it moves
integrate()
{
    [ -f "$EXE" ] || return 0
    [ "$ICON" -nt "$EXE" ] ||
        python3 "$TOOLS/exeicon.py" "$EXE" "$ICON" >> "$LOG" 2>&1 || cp "$HERE/chitulinux.png" "$ICON"
    mkdir -p "$(dirname "$DESKTOP")"
    local q
    q="$(printf '%q' "$SELF")"
    cat > "$DESKTOP.tmp" <<EOF
[Desktop Entry]
Type=Application
Name=CHITUBOX
Comment=Resin 3D printing slicer (ChituLinux $VERSION)
Exec=$q %F
Icon=$ICON
Terminal=false
Categories=Graphics;3DGraphics;Engineering;
MimeType=application/x-chitubox;model/stl;model/obj;model/3mf;
StartupWMClass=chitubox.exe
StartupNotify=true
Actions=settings;update;winecfg;stop;

[Desktop Action settings]
Name=Settings (scaling, graphics, Wine)
Exec=$q settings

[Desktop Action update]
Name=Check for updates
Exec=$q update

[Desktop Action winecfg]
Name=Wine configuration
Exec=$q winecfg

[Desktop Action stop]
Name=Stop CHITUBOX
Exec=$q stop
EOF
    if cmp -s "$DESKTOP.tmp" "$DESKTOP"; then
        rm -f "$DESKTOP.tmp"
    else
        mv -f "$DESKTOP.tmp" "$DESKTOP"
        update-desktop-database "$(dirname "$DESKTOP")" >/dev/null 2>&1
    fi
    # CHITUBOX projects open with CHITUBOX; STL and others only offer it
    local mime="${XDG_DATA_HOME:-$HOME/.local/share}/mime"
    if [ ! -f "$mime/packages/chitulinux.xml" ]; then
        mkdir -p "$mime/packages"
        cat > "$mime/packages/chitulinux.xml" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-chitubox">
    <comment>CHITUBOX project</comment>
    <glob pattern="*.chitubox"/>
  </mime-type>
</mime-info>
EOF
        update-mime-database "$mime" >/dev/null 2>&1
        xdg-mime default chitulinux-chitubox.desktop application/x-chitubox 2>/dev/null
    fi
    return 0
}

# --- updates -------------------------------------------------------------------------------------------

# the newest ChituLinux on GitHub: sets LATEST, LATEST_URL and LATEST_SUMS; fails when it can't be found
find_latest()  # [TIMEOUT]
{
    local info
    info="$(timeout "${1:-60}" python3 -I "$TOOLS/chitulinux-release.py" latest 2>>"$LOG")" || return 1
    { read -r LATEST; read -r LATEST_URL; read -r LATEST_SUMS; } <<< "$info"
    [ -n "$LATEST" ]
}

# LATEST, checked against its SHA256SUMS, next to this AppImage and in the app menu instead of it.
# A running CHITUBOX keeps this version until it closes
update_chitulinux()
{
    local release="$TOOLS/chitulinux-release.py" dir new
    [ -f "${APPIMAGE:-}" ] || { tell error "Only the ChituLinux AppImage can update itself."; return 1; }
    dir="$(dirname "$APPIMAGE")"
    [ -w "$dir" ] || dir="$HOME/Applications"
    mkdir -p "$dir"
    new="$dir/${LATEST_URL##*/}"
    msg "downloading $LATEST_URL"
    python3 -I "$release" download "$LATEST_SUMS" "$new.sha256" 2>>"$LOG" >/dev/null &&
        python3 -I "$release" download "$LATEST_URL" "$new" 2>>"$LOG" |
        if gui; then zenity --progress --auto-close --width=460 --title=ChituLinux \
            --text="Downloading ChituLinux $LATEST…" 2>/dev/null; else cat >/dev/null; fi
    if [ "${PIPESTATUS[0]}" != 0 ] || [ ! -f "$new" ]; then
        rm -f "$new.part" "$new.sha256"
        tell error "Downloading ChituLinux $LATEST failed or was cancelled."
        return 1
    fi
    if ! (cd "$dir" && grep -F " ${new##*/}" "$new.sha256" | sha256sum -c --status); then
        rm -f "$new" "$new.sha256"
        tell error "The downloaded ChituLinux doesn't match its checksum, nothing was changed."
        return 1
    fi
    rm -f "$new.sha256"
    chmod +x "$new"
    env -u APPIMAGE -u APPDIR -u ARGV0 -u OWD "$new" integrate ||
        { tell error "ChituLinux $LATEST doesn't start, this version stays."; return 1; }
    [ "$new" = "$APPIMAGE" ] || rm -f "$APPIMAGE"
    rm -f "$DATA/.update-skip"
    msg "updated to $new"
    tell info "ChituLinux is updated to $LATEST, from the next start of CHITUBOX." || true
}

update_question()
{
    zenity --question --width=480 --title=ChituLinux --icon="$ICON" \
        --ok-label="Update now" --cancel-label="Later" --extra-button="Skip this version" \
        --text="<big><b>ChituLinux $LATEST is available</b></big>\n\nThis is $VERSION. <b>Update now</b> downloads it and replaces this AppImage with it. CHITUBOX, its settings and your projects stay.\n\n<a href=\"$RELEASES/tag/v$LATEST\">What's new</a>\n\n<small>${1:-}</small>" 2>/dev/null
}

# At most once a day, in the background while CHITUBOX starts: offer a newer ChituLinux. Off with
# CHITULINUX_UPDATE_CHECK=0 or update-check off; no network means no question
start_update_check()
{
    local stamp="$DATA/.update-check"
    [ "${CHITULINUX_UPDATE_CHECK:-1}" != 0 ] && [ "$(cat "$DATA/update-check" 2>/dev/null)" != off ] &&
        gui && [ -f "${APPIMAGE:-}" ] && [ -n "$VERSION" ] || return 0
    [ -n "$(find "$stamp" -mmin -1440 2>/dev/null)" ] && return 0
    (
        sleep 20  # after CHITUBOX's splash
        find_latest 15 || exit 0
        touch "$stamp"
        newer "$LATEST" "$VERSION" && [ "$(cat "$DATA/.update-skip" 2>/dev/null)" != "$LATEST" ] || exit 0
        msg "ChituLinux $LATEST is available"
        answer="$(update_question "Turn this check off in Settings.")" && update_chitulinux
        [ "$answer" = "Skip this version" ] && echo "$LATEST" > "$DATA/.update-skip" && msg "skipping $LATEST"
    ) < /dev/null &
}

# Before CHITUBOX starts: a newer CHITUBOX installer in Downloads. CHITUBOX says when it has an update; its
# installer, downloaded, lands there
offer_chitubox_update()
{
    local inst v cur answer
    gui && [ -f "$EXE" ] && ! chitubox_running || return 0
    inst="$(find_installer)"
    v="$(installer_version "$inst")" cur="$(chitubox_version)"
    [ -n "$v" ] && [ -n "$cur" ] && newer "$v" "$cur" && [ "$(cat "$DATA/.chitubox-skip" 2>/dev/null)" != "$v" ] ||
        return 0
    msg "CHITUBOX $v is in $inst"
    answer="$(zenity --question --width=480 --title=ChituLinux --icon="$ICON" \
        --ok-label="Install now" --cancel-label="Later" --extra-button="Skip this version" \
        --text="<big><b>CHITUBOX $v</b></big>\n\n<tt>${inst/#$HOME/\~}</tt> is newer than CHITUBOX $cur here. Install it now? Your settings, printers and login stay." 2>/dev/null)" &&
        install_chitubox "$inst"
    [ "$answer" = "Skip this version" ] && echo "$v" > "$DATA/.chitubox-skip" && msg "skipping CHITUBOX $v"
    return 0
}

# the app menu's Check for updates: ChituLinux, then CHITUBOX
check_updates()
{
    local text='' inst v cur answer exe
    if [ -z "${APPIMAGE:-}" ]; then
        :
    elif ! find_latest 30; then
        text="GitHub could not be reached to look for a newer ChituLinux."
    elif newer "$LATEST" "$VERSION"; then
        if gui; then
            answer="$(update_question)" && update_chitulinux
            [ "$answer" = "Skip this version" ] && echo "$LATEST" > "$DATA/.update-skip"
        else
            update_chitulinux
        fi
    else
        text="ChituLinux $VERSION is the newest version."
    fi
    [ -f "$EXE" ] || { [ -z "$text" ] || tell info "$text"; return 0; }
    inst="$(find_installer)"
    v="$(installer_version "$inst")" cur="$(chitubox_version)"
    if [ -n "$v" ] && newer "$v" "${cur:-0}"; then
        tell question "${text:+$text\n\n}<b>CHITUBOX $v</b> is in <tt>${inst/#$HOME/\~}</tt>, CHITUBOX ${cur:-?} is installed. Install it now? Your settings, printers and login stay." &&
            install_chitubox "$inst"
        return 0
    fi
    text="${text:+$text\n\n}CHITUBOX ${cur:-?} is installed, there is no newer CHITUBOX installer in Downloads. CHITUBOX says when it has an update: download the Windows installer (64-bit) to Downloads and start CHITUBOX, or choose it here."
    gui || { msg "$text"; return 0; }
    answer="$(zenity --question --width=480 --title=ChituLinux --icon="$ICON" --text="$text" \
        --ok-label="Choose installer…" --cancel-label="Close" --extra-button="Download page" 2>/dev/null)" && {
        exe="$(zenity --file-selection --title='CHITUBOX installer' --filename="$HOME/Downloads/" \
            --file-filter='CHITUBOX installer | *.exe' 2>/dev/null)" && install_chitubox "$exe"
    }
    [ "$answer" = "Download page" ] && xdg-open "$CHITUBOX_DOWNLOAD" >/dev/null 2>&1 &
    return 0
}

# Resin Print Portal (github.com/MichielBruijn/Resin-Print-Portal) as a network printer in CHITUBOX, while it
# runs. It answers CHITUBOX on this computer, so RPP may be in another network
start_rpp_bridge()
{
    local url
    url="$(cat "$DATA/rpp-url" 2>/dev/null)"
    [ -n "$url" ] || return 0
    python3 -I "$TOOLS/rpp-bridge.py" --rpp "$url" --spool "$DATA/rpp" --log "$DATA/rpp-bridge.log" --watch $$ \
        < /dev/null > /dev/null 2>&1 &
}

start_chitubox()  # FILE...
{
    [ -f "$EXE" ] || install_chitubox
    offer_chitubox_update
    fix_drives
    apply_scale
    setup_gpu
    # the menu entry: points at this AppImage, also after it moved or was renamed, and has this version's actions
    integrate
    # Qt WebEngine shares its frames with Qt Quick as Direct3D 11 shared textures; DXVK only has those in
    # Proton. Its pages (login, news) draw fine without the GPU
    export QTWEBENGINE_CHROMIUM_FLAGS="${QTWEBENGINE_CHROMIUM_FLAGS:---disable-gpu}"
    # the sandboxed renderer hangs on its own desktop under Wine (get_desktop_window fails): Messages stays empty
    export QTWEBENGINE_DISABLE_SANDBOX="${QTWEBENGINE_DISABLE_SANDBOX:-1}"
    export DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-warn}" DXVK_LOG_PATH="${DXVK_LOG_PATH:-none}"
    local args=() f
    for f in "$@"; do
        [ -e "$f" ] && f="$("$WINE" winepath -w "$(readlink -f "$f")" 2>/dev/null)"
        args+=("$f")
    done
    msg "ChituLinux $VERSION, CHITUBOX $(chitubox_version), $(date '+%F %T')"
    start_update_check
    start_rpp_bridge
    cd "$WINEPREFIX/drive_c/Program Files/CHITUBOX" || exit 1
    exec "$WINE" "$EXE" "${args[@]}"
}

case "${1:-}" in
    install)   shift; install_chitubox "${1:-}" ;;
    update)    check_updates ;;
    update-check)
               case "${2:-}" in
                   off) echo off > "$DATA/update-check"; msg "no more looking for a newer ChituLinux at start" ;;
                   on)  rm -f "$DATA/update-check" "$DATA/.update-check" "$DATA/.update-skip"
                        msg "a start looks for a newer ChituLinux once a day" ;;
                   *)   msg "usage: update-check on|off"; exit 1 ;;
               esac ;;
    settings)  export CHITULINUX_RUN="$SELF" CHITULINUX_HOME="$DATA"
               python3 "$TOOLS/settings.py" 2>>"$LOG" || [ $? != 2 ] || exec "$0" winecfg ;;
    rpp)       case "${2:-}" in
                   ''|-h|--help) msg "usage: rpp URL|off"; exit 1 ;;
                   off) rm -f "$DATA/rpp-url"; msg "no RPP printer in CHITUBOX from the next start" ;;
                   http://*|https://*) echo "$2" > "$DATA/rpp-url"; msg "RPP at $2 from the next start of CHITUBOX" ;;
                   *) echo "http://$2" > "$DATA/rpp-url"; msg "RPP at http://$2 from the next start of CHITUBOX" ;;
               esac ;;
    scale)     case "${2:-}" in
                   auto) rm -f "$DATA/scale"; msg "scale follows the desktop" ;;
                   ''|*[!0-9]*) msg "usage: scale PERCENT|auto"; exit 1 ;;
                   *) echo "$2" > "$DATA/scale"; msg "scale $2% from the next start" ;;
               esac ;;
    winecfg|regedit) make_prefix; exec "$WINE" "$1" ;;
    shell)     msg "WINEPREFIX=$WINEPREFIX, wine is on PATH"; exec "${SHELL:-bash}" ;;
    stop)      stop_wine ;;
    integrate) integrate ;;
    -h|--help|help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0" ;;
    *)         mkdir -p "$DATA"; start_chitubox "$@" >> "$LOG" 2>&1 ;;
esac
